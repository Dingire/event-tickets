PORT=3000
ADMIN_PASSWORD=change-this-password
SESSION_SECRET=change-this-to-a-long-random-string

# --- Which gateway takes the payments -------------------------------------------
# elicate (default) or flutterwave. See providers/ for what each one expects.
PAYMENT_PROVIDER=elicate

# --- Elicate Pay (Zambia: MTN, Airtel, Zamtel, settled in ZMW) -------------------
# Self-service signup at https://elicatepay.online/auth/signup
# Keys are under Dashboard > API Keys. Test keys are ep_test_sk_... / ep_live_sk_...
ELICATE_SECRET_KEY=
# Any random string. Set the same value on the webhook URL you register in the
# Elicate dashboard; every delivery is signed with it and unsigned posts are refused.
ELICATE_WEBHOOK_SECRET=
# Override only if you are pointing at a mirror. The default already ends in /api/v1.
# ELICATE_API_BASE=https://elicatepay.vercel.app/api/v1

# --- Flutterwave (kept for a future enterprise-tier account) ---------------------
# Not usable with a standard account: Zambia sign-ups are limited to businesses with
# over $5m in annual payment volume. Everything below is ignored unless
# PAYMENT_PROVIDER=flutterwave.
FLW_SECRET_KEY=
# Any random string you also set in Dashboard > Settings > Webhooks. It must arrive
# in the verif-hash header.
FLW_SECRET_HASH=
# The /v3 prefix matters: the client appends /charges, /transactions, /transfers.
# FLW_API_BASE=https://api.flutterwave.com/v3
# Flutterwave's docs are inconsistent about the casing of the Zambia network value.
# FLW_NETWORK_AIRTEL=AIRTEL
# FLW_NETWORK_ZAMTEL=ZAMTEL

# Public base URL of this site. Used to send the customer back here after they
# approve or decline a payment, and printed at startup so it can be copied into the
# gateway dashboard as the webhook URL.
PUBLIC_URL=http://localhost:3000
# International dialling prefix, no "+" or spaces.
MM_COUNTRY_CODE=260
# How long a charge may stay in flight before the reconciler settles or releases it.
PAYMENT_WINDOW_MINUTES=120

# Abuse limits. Generous per-IP on purpose: many subscribers in Zambia share one
# carrier NAT address, so a tight per-IP cap would block real buyers. The per-phone
# cap is what stops someone farming every ticket into a pending reservation.
RATE_LIMIT_CHECKOUT_IP=20
RATE_LIMIT_CHECKOUT_PHONE=5
RATE_LIMIT_LOGIN=10

# Cap on a single payout, in ZMW. Set this to the smallest amount you would ever need
# to send in one go. Elicate Pay debits provider transfer charges on top of the amount,
# so keep headroom above this figure.
PAYOUT_MAX=50000

# Where the SQLite database and uploaded banners live.
# On Railway this MUST be a mounted volume at /app/data, otherwise every deploy
# wipes your orders, tickets, payouts and admin sessions:
#   railway volume add --mount-path /app/data
DATA_DIR=./data
