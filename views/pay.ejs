<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Secure Payment — <%= item ? methods[item.order.method].name : 'Payment' %></title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body style="background:#1a1136">
  <div class="pay-shell">
    <% if (!item) { %>
      <div class="pay-body" style="border-radius:14px;border-top:1px solid #e4e6f0">
        <p><% if (error) { %><%= error %><% } %></p>
        <p class="mt-8"><a href="/">&#8592; Back to event</a></p>
      </div>
    <% } else {
         const m = methods[item.order.method];
         const amt = Number(item.order.amount);
         const orderId = item.order.id;
    %>
      <div class="pay-brand <%= m.brand %>">
        <div class="tag">Secure checkout &middot; <%= m.name %></div>
        <h1><%= awaiting ? 'Confirming your payment' : 'Confirm your payment' %></h1>
      </div>

      <div class="pay-body">
        <% if (error) { %><div class="alert error"><%= error %></div><% } %>
        <% if (failure) { %><div class="alert error"><%= failure %></div><% } %>

        <div class="summary">
          <div class="row"><span>Event</span><strong><%= settings.eventName %></strong></div>
          <div class="row"><span>Date</span><span><%= toDateLabel %></span></div>
          <div class="row"><span>Tickets</span><span><%= item.order.qty %></span></div>
          <div class="row"><span>Paying from</span><span><%= item.order.phone %></span></div>
          <div class="row"><span>Receipt sent to</span><span><%= item.order.email %></span></div>
          <div class="row"><span>Booking reference</span><span class="ref"><%= item.order.booking_ref %></span></div>
          <div class="row total"><span>Amount payable</span><span><%= currency(amt) %></span></div>
        </div>

        <% if (awaiting) { %>
          <div class="pay-waiting" data-order="<%= orderId %>">
            <div class="spinner" aria-hidden="true"></div>
            <p><strong>Waiting for your approval.</strong></p>
            <p class="small muted">
              Approve the <%= currency(amt) %> payment on your <%= m.name %> phone.
              This page updates on its own &mdash; you can leave it open in another tab.
            </p>
            <p class="small muted">
              Already approved it? Press <strong>Check again</strong> below. Your tickets are
              issued the moment the payment is confirmed, even if this page was closed.
            </p>
            <p class="small muted">
              Your booking reference is <strong><%= item.order.booking_ref %></strong>.
              Keep it: it is how we find your payment.
            </p>
          </div>
          <p class="center small mt-16">
            <a href="/pay/return/<%= orderId %>">Check again</a> &middot;
            <a href="/ticket/<%= item.order.booking_ref %>">My tickets</a> &middot;
            <a href="/">Back to event</a>
          </p>
        <% } else { %>
          <form action="/pay/<%= orderId %>" method="post">
            <button type="submit" class="btn btn-primary btn-block">
              Pay <%= currency(amt) %> with <%= m.name %>
            </button>
          </form>

          <p class="center small mt-16">
            <a href="/pay/<%= orderId %>/cancel">Cancel booking</a>
          </p>

          <div class="pay-note">
            <strong>How this works:</strong> the next screen hands you to <%= m.name %>.
            You approve the payment on your own phone using your own PIN — this website
            never asks for, sees or stores your PIN.
          </div>
        <% } %>
      </div>
    <% } %>
  </div>

  <% if (awaiting) { %>
    <script>
      (function () {
        var orderId = document.querySelector('.pay-waiting').dataset.order;
        var tries = 0;
        var timer = setInterval(function () {
          tries += 1;
          fetch('/pay/return/' + orderId + '/status', { headers: { Accept: 'application/json' } })
            .then(function (r) { return r.json(); })
            .then(function (d) {
              if (d.state === 'paid') {
                clearInterval(timer);
                window.location = d.url;
              } else if (d.state === 'failed' || d.state === 'cancelled') {
                clearInterval(timer);
                window.location.reload();
              } else if (tries > 60) {
                clearInterval(timer);
                window.location = '/pay/return/' + orderId;
              }
            })
            .catch(function () {});
        }, 3000);
      })();
    </script>
  <% } %>
</body>
</html>
